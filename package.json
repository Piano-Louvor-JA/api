{
  "name": "piano-api",
  "version": "1.4.0",
  "description": "API propria pianolouvorja — hinarios SDA e Louvor JA",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -b tsconfig.app.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --write src/ test/",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "validate:pr": "biome check src/ test/ && tsc -p tsconfig.test.json --noEmit && vitest run",
    "import:upstream": "tsx scripts/import-upstream.ts",
    "import:sda": "tsx scripts/import-sda-hymnal.ts",
    "prepare": "[ \"$NODE_ENV\" = production ] || husky",
    "test:regression": "node scripts/test-regression.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/node-ws": "^1.3.1",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.6",
    "better-sqlite3": "^11.0.0",
    "firebase-admin": "^14.5.0",
    "hono": "^4.13.9",
    "kysely": "^0.29.6",
    "nodemailer": "^10.0.10",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "lint-staged": {
    "*.{ts,json}": [
      "biome check --write"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-istanbul": "^5.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@hono/node-ws": {
      "@hono/node-server": "$@hono/node-server"
    }
  }
}
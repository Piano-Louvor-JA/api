# Production
#- NODE_ENV=production
#- DB_PATH=/app/data/catalog.db
#- MEDIA_DIR=/app/media
#- PORT=3100

# Development
NODE_ENV=development
DB_PATH=./data/catalog.db
MEDIA_DIR=./media
PORT=3100

# Cache TTLs
CACHE_TTL_HYMN=86400
CACHE_TTL_AUDIO=3600
CACHE_TTL_BIBLE=604800
RATE_LIMIT_PER_MIN=100
# Origens CORS separadas por vírgula (default * para compat com apps)
CORS_ORIGINS=*
# true apenas atrás de proxy confiável (Cloudflare Tunnel) — habilita X-Forwarded-For no rate limit
TRUSTED_PROXY=false

# Upstream API
UPSTREAM_API=https://api.louvorja.com.br
UPSTREAM_FALLBACK_API=https://api.louvorja.workers.dev
FIREBASE_PROJECT_ID=pianolouvorja

# Palco Relay Key
PALCO_RELAY_KEY=

# SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Piano LouvorJA <noreply@pianolouvorja.com.br>
